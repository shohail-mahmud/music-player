{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper",
  "version": "0.1.0",
  "identifier": "dev.vesper.player",
  "mainBinaryName": "vesper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vesper — Local Music",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "widget",
        "url": "index.html?window=widget",
        "title": "Vesper Widget",
        "width": 384,
        "height": 188,
        "minWidth": 260,
        "minHeight": 88,
        "maxWidth": 560,
        "maxHeight": 340,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Vesper",
    "copyright": "© 2026 Vesper. All rights reserved.",
    "shortDescription": "Local music player with a glass desktop widget.",
    "longDescription": "Vesper plays the music files already on your machine. It imports folders as playlists, extracts real metadata and artwork, and floats a translucent mini-player above your desktop. No account, no cloud, no telemetry.",
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
